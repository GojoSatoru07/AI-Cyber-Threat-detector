# Copy to .env and adjust. All values are optional; defaults shown.

# ---- Data ----------------------------------------------------------------
# The capture under inspection.
DATA_FILE=data/packets.csv
# Known-good traffic to fit on. THIS IS THE IMPORTANT ONE: without it the model
# is fitted on the same traffic it inspects, which teaches it that any attack
# present is part of normal, and reduces alerting to a fixed quota.
# BASELINE_FILE=data/baseline.csv
MODEL_FILE=models/model.pkl

# ---- Detection -----------------------------------------------------------
# "flow" aggregates packets into (source, window) sessions — required to see
# port scans, sweeps and beaconing. "packet" scores each packet alone.
FEATURE_SET=flow
# Session window. Must be longer than the period of any beacon you hope to see;
# too long and bursts average away. 300s detects all four planted attacks.
WINDOW_SECONDS=300

# Detector: "iforest" (default) or "lof".
ALGORITHM=iforest
N_ESTIMATORS=100
RANDOM_STATE=42

# "auto" keeps scikit-learn's data-independent score offset. A number turns
# detection into a quota: it flags that fraction whether or not anything is
# wrong.
CONTAMINATION=auto

# Alert threshold, calibrated at training time as this quantile of the training
# scores. Unset resolves to 0.0 with a baseline, or a 2% quota without one.
# CALIBRATION_QUANTILE=0.0
# Hard override of the calibrated threshold.
# SCORE_THRESHOLD=-0.15

# HMAC key protecting the model file from being swapped for a hostile pickle.
# Generated per-install under models/ if unset.
# MODEL_SIGNING_KEY=

# ---- Server --------------------------------------------------------------
MAX_RESULTS=500
# Never enable debug on a reachable host: the Werkzeug debugger grants remote
# code execution.
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
